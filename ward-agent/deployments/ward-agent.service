[Unit]
Description=Ward WAF Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ward-agent
Group=ward-agent
ExecStart=/usr/local/bin/ward-agent --config /etc/ward-agent/config.yaml
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ward-agent
WorkingDirectory=/var/lib/ward-agent
EnvironmentFile=-/etc/ward-agent/environment

[Install]
WantedBy=multi-user.target
